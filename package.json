{
  "name": "mochi-write",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build --config tests/e2e/vite.config.ts && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "transfer": "node --import tsx src/server/transfer-cli.ts",
    "test:integration": "node --import tsx tests/integration/run.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "4.10.0",
    "@azure/identity": "4.13.2",
    "@azure/msal-browser": "5.21.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
